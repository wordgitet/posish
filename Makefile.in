.POSIX:
.SUFFIXES: .c .o

SHELL = /bin/sh

CC = @CC@
CPPFLAGS = @CPPFLAGS@ -D_POSIX_C_SOURCE=200809L -Iinclude -Isrc -include config.h -include compat.h
CFLAGS = @CFLAGS@ -Wall -Wextra -Wpedantic
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
SAN_CFLAGS = -O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined
SAN_LDFLAGS = -fsanitize=address,undefined
YASH_RUNNER = @YASH_RUNNER@

BUILD_DIR = build
TARGET = $(BUILD_DIR)/posish
METRICS_CSV = tmp/metrics/posix.csv

SRC = \
	src/main.c \
	src/shell.c \
	src/input.c \
	src/lexer.c \
	src/parser.c \
	src/arith.c \
	src/ast_exec.c \
	src/case_command.c \
	src/compound_parse.c \
	src/heredoc_command.c \
	src/command_subst.c \
	src/field_split.c \
	src/program_text.c \
	src/simple_command.c \
	src/spawn.c \
	src/expand.c \
	src/exec.c \
	src/functions.c \
	src/alias.c \
	src/redir.c \
	src/jobs.c \
	src/signals.c \
	src/symbols.c \
	src/trace.c \
	src/vars.c \
	src/options.c \
	src/prompt.c \
	src/path.c \
	src/error_catalog.c \
	src/error.c \
	src/arena.c \
	src/builtins/special.c \
	src/builtins/regular.c \
	src/builtins/test.c

OBJ = \
	src/main.o \
	src/shell.o \
	src/input.o \
	src/lexer.o \
	src/parser.o \
	src/arith.o \
	src/ast_exec.o \
	src/case_command.o \
	src/compound_parse.o \
	src/heredoc_command.o \
	src/command_subst.o \
	src/field_split.o \
	src/program_text.o \
	src/simple_command.o \
	src/spawn.o \
	src/expand.o \
	src/exec.o \
	src/functions.o \
	src/alias.o \
	src/redir.o \
	src/jobs.o \
	src/signals.o \
	src/symbols.o \
	src/trace.o \
	src/vars.o \
	src/options.o \
	src/prompt.o \
	src/path.o \
	src/error_catalog.o \
	src/error.o \
	src/arena.o \
	src/builtins/special.o \
	src/builtins/regular.o \
	src/builtins/test.o

SMOKE_TEST_SOURCES = \
	nop-p.tst \
	andor-p.tst \
	exec-p.tst \
	simple-p.tst \
	sigstop3-p.tst
TESTCASE_TIMEOUT ?= 0
# Stop-family signal tests are most reliable in truth mode (no per-case watchdog).
TESTCASE_TIMEOUT_STOP ?= 0
TESTCASE_TIMEOUT_SIGNAL ?= 0
SIGNAL_FILE_TIMEOUT ?= 180
SIGNAL_FILE_TIMEOUT_KILL ?= 5
FILE_TIMEOUT ?= 200
KILL_AFTER ?= 5
FULLTRUTH_SUMMARY ?= summary-fulltruth.log
FULLTRUTH_CSV ?= summary-fulltruth.csv

all: $(TARGET)

$(TARGET): $(OBJ)
	mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJ) $(LIBS)

.c.o:
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

test-posix: $(TARGET)
	@if [ -n "$(TESTEE)" ]; then testee="$(TESTEE)"; else testee="`pwd`/$(TARGET)"; fi; \
	$(MAKE) -C tests/posix test-posix \
		YASH_RUNNER="$(YASH_RUNNER)" \
		TESTEE="$$testee" \
		TESTCASE_TIMEOUT="$(TESTCASE_TIMEOUT)"

test-posix-nosignal: $(TARGET)
	@if [ -n "$(TESTEE)" ]; then testee="$(TESTEE)"; else testee="`pwd`/$(TARGET)"; fi; \
	$(MAKE) -C tests/posix test-posix-nosignal \
		YASH_RUNNER="$(YASH_RUNNER)" \
		TESTEE="$$testee" \
		TESTCASE_TIMEOUT="$(TESTCASE_TIMEOUT)"

build-sanitize:
	$(MAKE) clean
	$(MAKE) CFLAGS="$(CFLAGS) $(SAN_CFLAGS)" \
		LDFLAGS="$(LDFLAGS) $(SAN_LDFLAGS)" all

test-sanitize-smoke:
	$(MAKE) CFLAGS="$(CFLAGS) $(SAN_CFLAGS)" \
		LDFLAGS="$(LDFLAGS) $(SAN_LDFLAGS)" test-smoke

test-sanitize-guards:
	$(MAKE) CFLAGS="$(CFLAGS) $(SAN_CFLAGS)" \
		LDFLAGS="$(LDFLAGS) $(SAN_LDFLAGS)" test-smoke
	$(MAKE) CFLAGS="$(CFLAGS) $(SAN_CFLAGS)" \
		LDFLAGS="$(LDFLAGS) $(SAN_LDFLAGS)" test-regressions
	$(MAKE) CFLAGS="$(CFLAGS) $(SAN_CFLAGS)" \
		LDFLAGS="$(LDFLAGS) $(SAN_LDFLAGS)" test-stop
	$(MAKE) CFLAGS="$(CFLAGS) $(SAN_CFLAGS)" \
		LDFLAGS="$(LDFLAGS) $(SAN_LDFLAGS)" test-signal

test-sanitize-posix:
	$(MAKE) CFLAGS="$(CFLAGS) $(SAN_CFLAGS)" \
		LDFLAGS="$(LDFLAGS) $(SAN_LDFLAGS)" \
		test-posix TESTCASE_TIMEOUT=0

test-stress-arena:
	$(MAKE) clean
	$(MAKE) all
	@echo ">>> arena growth stress"
	@TESTEE="`pwd`/$(TARGET)" ./tests/stress/arena_growth_stress.sh
	@echo ">>> heredoc pressure stress"
	@TESTEE="`pwd`/$(TARGET)" ./tests/stress/heredoc_pressure.sh

test-smoke: $(TARGET)
	@if [ -n "$(TESTEE)" ]; then testee="$(TESTEE)"; else testee="`pwd`/$(TARGET)"; fi; \
	$(MAKE) -C tests/posix test-smoke \
		YASH_RUNNER="$(YASH_RUNNER)" \
		TESTEE="$$testee" \
		SMOKE_TEST_SOURCES="$(SMOKE_TEST_SOURCES)" \
		TESTCASE_TIMEOUT="$(TESTCASE_TIMEOUT)"

test-stop: $(TARGET)
	@if [ -n "$(TESTEE)" ]; then testee="$(TESTEE)"; else testee="`pwd`/$(TARGET)"; fi; \
	$(MAKE) -C tests/posix test-stop \
		YASH_RUNNER="$(YASH_RUNNER)" \
		TESTEE="$$testee" \
		TESTCASE_TIMEOUT_STOP="$(TESTCASE_TIMEOUT_STOP)"

test-signal: $(TARGET)
	@if [ -n "$(TESTEE)" ]; then testee="$(TESTEE)"; else testee="`pwd`/$(TARGET)"; fi; \
	$(MAKE) -C tests/posix test-signal \
		YASH_RUNNER="$(YASH_RUNNER)" \
		TESTEE="$$testee" \
		TESTCASE_TIMEOUT_SIGNAL="$(TESTCASE_TIMEOUT_SIGNAL)"

test-signal-contained: $(TARGET)
	@if [ -n "$(TESTEE)" ]; then testee="$(TESTEE)"; else testee="`pwd`/$(TARGET)"; fi; \
	$(MAKE) -C tests/posix test-signal-contained \
		YASH_RUNNER="$(YASH_RUNNER)" \
		TESTEE="$$testee" \
		TESTCASE_TIMEOUT_SIGNAL="$(TESTCASE_TIMEOUT_SIGNAL)" \
		SIGNAL_FILE_TIMEOUT="$(SIGNAL_FILE_TIMEOUT)" \
		SIGNAL_FILE_TIMEOUT_KILL="$(SIGNAL_FILE_TIMEOUT_KILL)"

test-regressions: $(TARGET)
	@if [ -n "$(TESTEE)" ]; then testee="$(TESTEE)"; else testee="`pwd`/$(TARGET)"; fi; \
	$(MAKE) -C tests/posix test-regressions \
		YASH_RUNNER="$(YASH_RUNNER)" \
		TESTEE="$$testee" \
		TESTCASE_TIMEOUT_SIGNAL="$(TESTCASE_TIMEOUT_SIGNAL)"

metrics: $(TARGET)
	mkdir -p tmp/metrics
	@if [ -n "$(METRICS_TEST_SOURCES)" ]; then \
		$(MAKE) -C tests/posix test \
			YASH_RUNNER="$(YASH_RUNNER)" \
			TESTEE="`pwd`/$(TARGET)" \
			TEST_SOURCES="$(METRICS_TEST_SOURCES)" || true; \
	else \
		$(MAKE) test-posix || true; \
	fi
	$(SHELL) scripts/append-metrics.sh tests/posix/summary.log $(METRICS_CSV)

clean:
	rm -f $(OBJ)
	rm -rf $(BUILD_DIR)
	$(MAKE) -C tests/posix clean

.PHONY: all clean build-sanitize test-sanitize-smoke test-sanitize-guards test-sanitize-posix test-stress-arena test-posix test-smoke test-stop test-signal test-signal-contained test-regressions metrics
